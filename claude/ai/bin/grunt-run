#!/usr/bin/env bash
# grunt-run — run a self-contained brief on the cheap lane (OpenCode Go), falling over to the next model when one hits its cap.
# When the cheap lane is off (ai-lane) or every OpenCode model is limited, the brief runs in a headless Claude session on Sonnet instead
# (0.14.2), so the rote chunks of an Opus implementer never land on Opus.
# Usage: grunt-run [--dir <path>] [--agent build|plan] [--no-claude] "<brief>"
#        --no-claude: no Sonnet fallback — exit 75/76 as before (the grunt agent passes it: it already runs on Sonnet and does the work itself)
#        grunt-run --free-status [--dir <path>]   prints the free models usable here and exits 0; exits 1 when there are none
# Env:   GRUNT_MODELS="m1 m2 m3"   (default: DeepSeek V4.1 Flash → GLM-5.3-flash → Qwen3.8-flash; any OpenCode model ids)
#        OPENCODE_FREE_MODELS="opencode/x-free …"   tried first while they are free (see _common.sh free_models; repo opt-out: git config ai-loop.freelane off)
#        GRUNT_VARIANT=high
#        GRUNT_TIMEOUT=2400        seconds for one model before it is killed     GRUNT_STALL_TIMEOUT=600  seconds of total silence before it is killed
#        AI_LIMIT_COOLDOWN=1800    skip time for a limited model that did not say when it resets (when it does say, that time is used)
#        GRUNT_QA_PASS=0           don't append the closing quality-pass instruction (build agent only; on by default)
#        AI_CHEAP_LANE=off         the cheap lane is off for this shell (per clone: git config ai-loop.cheaplane off; `ai-lane` shows and sets it)
#        GRUNT_CLAUDE_MODEL=sonnet  GRUNT_CLAUDE_EFFORT=medium   the Sonnet fallback (GRUNT_CLAUDE=0 turns it off)
#        GRUNT_CLAUDE_PERMISSION=auto (else AI_NIGHT_PERMISSION; `ai-night --smoke` checks the mode works headless)   GRUNT_CLAUDE_MAX_TURNS=80
# Exit:  0 = done (first output line: WORKER: <model>)   75 = every lane limited/failing, Sonnet included — do it yourself
#        76 = the cheap lane is off here and the Sonnet fallback did not run (--no-claude, GRUNT_CLAUDE=0, limited or failed) — do it yourself   64 = usage
set -u
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"
LANE_TIMEOUT="${GRUNT_TIMEOUT:-2400}"; STALL_TIMEOUT="${GRUNT_STALL_TIMEOUT:-600}"   # build work may sit in a long test run, so more patience than a review
MODELS="${GRUNT_MODELS:-opencode-go/deepseek-v4.1-flash opencode-go/glm-5.3-flash opencode-go/qwen3.8-flash}"
VARIANT="${GRUNT_VARIANT:-high}"
CLAUDE_MODEL="${GRUNT_CLAUDE_MODEL:-sonnet}"; CLAUDE_EFFORT="${GRUNT_CLAUDE_EFFORT:-medium}"
CLAUDE_PERM="${GRUNT_CLAUDE_PERMISSION:-${AI_NIGHT_PERMISSION:-auto}}"; CLAUDE_TURNS="${GRUNT_CLAUDE_MAX_TURNS:-80}"
DIR=""; AGENT="build"; STATUS=0; NO_CLAUDE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --free-status) STATUS=1; shift ;;
    --no-claude) NO_CLAUDE=1; shift ;;
    --dir)   DIR="$2"; shift 2 ;;
    --agent) AGENT="$2"; shift 2 ;;
    -h|--help) sed -n '2,/^#        76 =/p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[ -z "$DIR" ] || cd "$DIR" || { echo "grunt-run: cannot cd to $DIR" >&2; exit 64; }   # opencode 2.x has no --dir: run from the directory instead
BRIEF="$*"; ORIG_BRIEF="$BRIEF"

# claude_lane <why> — the Sonnet fallback: run the brief in a headless Claude session. Prints the result and exits 0 when it worked;
# returns 1 when it is turned off, unavailable, limited or failed (the caller then exits 75/76). Sonnet costs Max quota, not OpenCode credit.
# stream-json keeps the watchdog fed (plain -p prints nothing until the end); the result event carries the answer and is_error.
# The child gets no advisor (claude is called directly), no auto-handoff, and Sonnet subagents (the parent's CLAUDE_CODE_SUBAGENT_MODEL is opus).
claude_lane() { local why="$1" lane out err rc txt w ro=""
  { [ "$NO_CLAUDE" = 1 ] || [ "${GRUNT_CLAUDE:-1}" = 0 ]; } && return 1
  command -v claude >/dev/null 2>&1 || { echo "grunt-run: no Sonnet fallback — claude is not on PATH" >&2; return 1; }
  lane="claude/$CLAUDE_MODEL"
  if recently_limited "$lane"; then echo "grunt-run: skipping $lane — back $(lane_back "$lane")" >&2; return 1; fi
  [ "$AGENT" = plan ] && ro="Write,Edit,NotebookEdit"
  out="$(mktemp)"; err="$(mktemp)"; txt="$(mktemp)"
  printf '%s\n\nDo not commit. End with a short report: the files you changed, the checks you ran and their results, and anything the brief left ambiguous.\n' "$ORIG_BRIEF" > "$out.prompt"
  echo "grunt-run: $why — running the brief on Claude $CLAUDE_MODEL (effort $CLAUDE_EFFORT)" >&2
  LANE_DETAIL="$AGENT"
  run_lane "grunt-run: $lane" "$out" "$err" env AUTO_HANDOFF_DISABLE=1 CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1 CLAUDE_CODE_SUBAGENT_MODEL="$CLAUDE_MODEL" \
    sh -c 'exec claude -p --model "$1" --effort "$2" --permission-mode "$3" --max-turns "$4" ${5:+--disallowedTools "$5"} --output-format stream-json --verbose < "$6"' \
    claude-lane "$CLAUDE_MODEL" "$CLAUDE_EFFORT" "$CLAUDE_PERM" "$CLAUDE_TURNS" "$ro" "$out.prompt"; rc=$?
  "$_PY" -c '
import json,sys
res=None
for line in open(sys.argv[1],errors="replace"):
    line=line.strip()
    if not line.startswith("{"): continue
    try: d=json.loads(line)
    except Exception: continue
    if d.get("type")=="result": res=d
if res is None: sys.exit(2)
open(sys.argv[2],"w").write(str(res.get("result") or ""))
sys.exit(1 if res.get("is_error") or res.get("subtype","success")!="success" else 0)' "$out" "$txt"; local prc=$?
  if [ $rc -eq 0 ] && [ $prc -eq 0 ]; then
    echo "WORKER: claude $CLAUDE_MODEL (effort $CLAUDE_EFFORT; $why)"; note_last grunt-run "$lane" done "$AGENT"; cat "$txt"; echo
    rm -f "$out" "$err" "$txt" "$out.prompt"; exit 0; fi
  if [ $rc -eq 200 ] || grep -Eiq "$LIMIT_RE|hit your limit|resets [0-9]" "$txt" "$err" 2>/dev/null; then
    mark_limited "$lane" limit "$txt" "$err"; w="$(limit_wait "$txt" "$err")"   # Claude says "resets 3am"; _limits.py does not read that form
    [ -n "$w" ] && printf '%s\nreported\n%s\n' "$(( $(now) + w ))" "$(grep -Eio '.{0,40}hit your.{0,60}' "$txt" "$err" 2>/dev/null | head -1 | sed 's/^[^:]*://')" > "$(lane_key "$lane")"
    echo "grunt-run: $lane is at its limit — back $(lane_back "$lane")" >&2
  elif [ $rc -eq 201 ]; then mark_limited "$lane" stalled
  elif [ $rc -eq 202 ]; then mark_limited "$lane" timeout
  else echo "grunt-run: $lane failed (exit $rc). $(head -c 600 "$txt" 2>/dev/null) $(tail -c 600 "$err" 2>/dev/null)" >&2; fi
  note_last grunt-run "$lane" failed "$AGENT"
  rm -f "$out" "$err" "$txt" "$out.prompt"; return 1; }

if cheap_lane_off "$DIR"; then
  [ "$STATUS" = 1 ] && { echo "free: none (the cheap lane is off here — ai-lane)"; exit 1; }
  [ -n "$BRIEF" ] || { echo "grunt-run: no brief given" >&2; exit 64; }
  claude_lane "cheap lane off"
  echo "WORKER: none — the cheap lane is off here (ai-lane shows why: AI_CHEAP_LANE or git config ai-loop.cheaplane) and the Sonnet fallback did not run. Do this chunk yourself and say so in the report." >&2; exit 76
fi
LANE_DETAIL="$AGENT"
FREE="$(free_models "$DIR")"
if [ "$STATUS" = 1 ]; then
  if [ -n "$FREE" ] && command -v opencode >/dev/null 2>&1; then echo "free: $FREE"; exit 0; fi
  echo "free: none${OPENCODE_FREE_MODELS:+ (listed but skipped, opted out here, or opencode missing)}"; exit 1
fi
# Free models first, then the configured ones (a model listed in both is tried once).
ALL=""; for m in $FREE $MODELS; do case " $ALL " in *" $m "*) ;; *) ALL="$ALL $m" ;; esac; done; MODELS="${ALL# }"
[ -n "$BRIEF" ] || { echo "grunt-run: no brief given" >&2; exit 64; }
# Cheap verbose models merge cleaner with a closing self-review. Keep this line out of prompts for frontier models, where it only burns tokens.
if [ "$AGENT" = build ] && [ "${GRUNT_QA_PASS:-1}" != "0" ]; then
  BRIEF="$BRIEF

When the work is complete, spawn a subagent to do one full quality pass over your changes for remaining bugs, missed edge cases and rough edges. Fix what it finds, then re-run the checks named above."
fi
command -v opencode >/dev/null 2>&1 || { claude_lane "opencode not on PATH"; echo "WORKER: none (opencode is not installed or not on PATH; no Sonnet fallback)" >&2; exit 75; }

go_limited=0
for m in $MODELS; do
  if recently_limited "$m"; then echo "grunt-run: skipping $m — back $(lane_back "$m")" >&2; continue; fi
  out="$(mktemp)"; err="$(mktemp)"
  # --print-logs: `opencode run` retries a limited provider forever in silence; the logs on stderr are where the watchdog sees the limit.
  run_lane "grunt-run: $m" "$out" "$err" opencode run --print-logs --agent "$AGENT" --model "$m${VARIANT:+#$VARIANT}" --auto "$BRIEF"; rc=$?   # opencode 2.x: variant rides on the model id
  if [ $rc -eq 0 ]; then if is_free "$m"; then echo "WORKER: $m (free)"; else echo "WORKER: $m"; fi; note_last grunt-run "$m" done "$AGENT"; cat "$out"; rm -f "$out" "$err"; exit 0; fi
  if [ $rc -eq 200 ] || { [ $rc -lt 200 ] && failed_on_limit "$out" "$err"; }; then
    mark_limited "$m" limit "$err" "$out"; echo "grunt-run: $m is at its limit — back $(lane_back "$m"). Trying the next model" >&2
    if [ "$(provider_of "$m")" = opencode-go ]; then go_limited=$(( go_limited + 1 ))   # one exhausted Go model can block the subscription (anomalyco/opencode #49014)
      if [ $go_limited -ge 2 ]; then cp "$(lane_key "$m")" "$(lane_key opencode-go)"; echo "grunt-run: two Go models at their limit — skipping all of opencode-go until $(lane_back opencode-go)" >&2; rm -f "$out" "$err"; break; fi; fi
  elif [ $rc -eq 201 ]; then mark_limited "$m" stalled
  elif [ $rc -eq 202 ]; then mark_limited "$m" timeout
  else echo "grunt-run: $m failed (exit $rc, not a limit). stderr:" >&2; grep -E '^[^ +-]' "$err" | tail -c 1500 >&2; echo >&2
    if model_disabled "$err"; then mark_disabled "$m"; echo "grunt-run: $m is not available to this account — skipped for a day; take it out of the model lists" >&2; rm -f "$out" "$err"; continue; fi
    if cli_rejected "$err"; then rm -f "$out" "$err"; claude_lane "opencode rejected the command line"; echo "WORKER: none — opencode $(opencode --version 2>/dev/null) rejected the command line (see stderr above); grunt-run needs updating for it. Do this chunk yourself and say so in the report." >&2; exit 75; fi
    is_free "$m" && mark_limited "$m" stalled   # free periods end without notice: a retired free model is skipped for 15 min instead of failing every call
  fi
  rm -f "$out" "$err"
done
back=""; recently_limited opencode-go && back=" opencode-go back $(lane_back opencode-go)."
claude_lane "every OpenCode lane limited"
note_last grunt-run none "no lane answered" "$AGENT"
echo "WORKER: none — every OpenCode lane is limited or failing ($MODELS), and the Sonnet fallback did not run.$back Do this chunk yourself and say so in the report." >&2
exit 75
