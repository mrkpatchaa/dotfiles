#!/usr/bin/env bash
# grunt-run — run a self-contained brief on the cheap lane (OpenCode Go), falling over to the next model when one hits its cap.
# Usage: grunt-run [--dir <path>] [--agent build|plan] "<brief>"
#        grunt-run --free-status [--dir <path>]   prints the free models usable here and exits 0; exits 1 when there are none
# Env:   GRUNT_MODELS="m1 m2 m3"   (default: DeepSeek V4.1 Flash → GLM-5.3-flash → Qwen3.8-flash; any OpenCode model ids)
#        OPENCODE_FREE_MODELS="opencode/x-free …"   tried first while they are free (see _common.sh free_models; repo opt-out: git config ai-loop.freelane off)
#        GRUNT_VARIANT=high
#        GRUNT_TIMEOUT=2400        seconds for one model before it is killed     GRUNT_STALL_TIMEOUT=600  seconds of total silence before it is killed
#        AI_LIMIT_COOLDOWN=1800    skip time for a limited model that did not say when it resets (when it does say, that time is used)
#        GRUNT_QA_PASS=0           don't append the closing quality-pass instruction (build agent only; on by default)
# Exit:  0 = done (first output line: WORKER: <model>)   75 = every lane limited/failing — do it yourself   64 = usage
set -u
. "$(cd "$(dirname "$0")" && pwd)/_common.sh"
LANE_TIMEOUT="${GRUNT_TIMEOUT:-2400}"; STALL_TIMEOUT="${GRUNT_STALL_TIMEOUT:-600}"   # build work may sit in a long test run, so more patience than a review
MODELS="${GRUNT_MODELS:-opencode-go/deepseek-v4.1-flash opencode-go/glm-5.3-flash opencode-go/qwen3.8-flash}"
VARIANT="${GRUNT_VARIANT:-high}"
DIR=""; AGENT="build"; STATUS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --free-status) STATUS=1; shift ;;
    --dir)   DIR="$2"; shift 2 ;;
    --agent) AGENT="$2"; shift 2 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
FREE="$(free_models "$DIR")"
if [ "$STATUS" = 1 ]; then
  if [ -n "$FREE" ] && command -v opencode >/dev/null 2>&1; then echo "free: $FREE"; exit 0; fi
  echo "free: none${OPENCODE_FREE_MODELS:+ (listed but skipped, opted out here, or opencode missing)}"; exit 1
fi
# Free models first, then the configured ones (a model listed in both is tried once).
ALL=""; for m in $FREE $MODELS; do case " $ALL " in *" $m "*) ;; *) ALL="$ALL $m" ;; esac; done; MODELS="${ALL# }"
BRIEF="$*"
[ -n "$BRIEF" ] || { echo "grunt-run: no brief given" >&2; exit 64; }
# Cheap verbose models merge cleaner with a closing self-review. Keep this line out of prompts for frontier models, where it only burns tokens.
if [ "$AGENT" = build ] && [ "${GRUNT_QA_PASS:-1}" != "0" ]; then
  BRIEF="$BRIEF

When the work is complete, spawn a subagent to do one full quality pass over your changes for remaining bugs, missed edge cases and rough edges. Fix what it finds, then re-run the checks named above."
fi
command -v opencode >/dev/null 2>&1 || { echo "WORKER: none (opencode is not installed or not on PATH)" >&2; exit 75; }

go_limited=0
for m in $MODELS; do
  if recently_limited "$m"; then echo "grunt-run: skipping $m — back $(lane_back "$m")" >&2; continue; fi
  out="$(mktemp)"; err="$(mktemp)"
  # --print-logs: `opencode run` retries a limited provider forever in silence; the logs on stderr are where the watchdog sees the limit.
  run_lane "grunt-run: $m" "$out" "$err" opencode run --print-logs ${DIR:+--dir "$DIR"} --agent "$AGENT" --model "$m" --variant "$VARIANT" --auto "$BRIEF"; rc=$?
  if [ $rc -eq 0 ]; then if is_free "$m"; then echo "WORKER: $m (free)"; else echo "WORKER: $m"; fi; cat "$out"; rm -f "$out" "$err"; exit 0; fi
  if [ $rc -eq 200 ] || { [ $rc -lt 200 ] && failed_on_limit "$out" "$err"; }; then
    mark_limited "$m" limit "$err" "$out"; echo "grunt-run: $m is at its limit — back $(lane_back "$m"). Trying the next model" >&2
    if [ "$(provider_of "$m")" = opencode-go ]; then go_limited=$(( go_limited + 1 ))   # one exhausted Go model can block the subscription (anomalyco/opencode #49014)
      if [ $go_limited -ge 2 ]; then cp "$(lane_key "$m")" "$(lane_key opencode-go)"; echo "grunt-run: two Go models at their limit — skipping all of opencode-go until $(lane_back opencode-go)" >&2; rm -f "$out" "$err"; break; fi; fi
  elif [ $rc -eq 201 ]; then mark_limited "$m" stalled
  elif [ $rc -eq 202 ]; then mark_limited "$m" timeout
  else echo "grunt-run: $m failed (exit $rc, not a limit). stderr:" >&2; grep -E '^[^ +-]' "$err" | tail -c 1500 >&2; echo >&2
    is_free "$m" && mark_limited "$m" stalled   # free periods end without notice: a retired free model is skipped for 15 min instead of failing every call
  fi
  rm -f "$out" "$err"
done
back=""; recently_limited opencode-go && back=" opencode-go back $(lane_back opencode-go)."
echo "WORKER: none — every OpenCode lane is limited or failing ($MODELS).$back Do this chunk yourself and say so in the report." >&2
exit 75
